@model RegresionLinealModel
@{
    Layout = null;
    ViewData["Title"] = "RegresionLineal";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css"> 
<style>
    /* La misma grilla de la Unidad 1 */
    .app-container {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 20px;
        padding: 20px;
        background-color: #f8f9fa;
        min-height: 100vh;
    }

    /* Nota: Agrandé un poco la primera columna (de 320px a 400px) para que entren más cuadraditos de la matriz sin romperse */
    .content-area {
        display: grid;
        grid-template-columns: 400px 1fr;
        gap: 20px;
    }

    /* Estilos de la cuadrilla de Gauss */
    .matrix-input {
        width: 55px;
        height: 38px;
        text-align: center;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        outline: none;
        transition: 0.2s;
    }

        .matrix-input:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

    .matrix-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        justify-content: center;
    }

    .equals-sign {
        font-weight: bold;
        color: #6c757d;
        margin: 0 2px;
    }

    .matrix-wrapper {
        overflow-x: auto;
        padding-bottom: 10px;
    }
    /* Por si hacen matrices muy grandes */
</style>

<div class="content-area">
    <div class="card p-3 shadow-sm border-0">
        <div class="mb-3 d-flex gap-2">
            <a class="btn btn-dark btn-sm" href="/Home/Index">Unidad 1</a>
            <a class="btn btn-dark btn-sm" href="/GaussJordan/GJ">Unidad 2</a>
            <a class="btn btn-dark btn-sm" href="#">Unidad 3</a>
        </div>
        <ul class="nav nav-tabs mb-3 flex-column border-0">
            <li class="nav-item">
                <a class="nav-link active text-dark fw-bold border-bottom" href="#">Regresion Lineal</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-muted" href="/RegresionPolinomial/RegresionPolinomial">Regresion Polinomial</a>
            </li>
        </ul>
    </div>
    <div class="content-area">
        
        <div class="card p-4 shadow-sm border-0">
            <h4 class="text-secondary mb-4">Datos de Entrada</h4>
            
            @if (!string.IsNullOrEmpty(Model?.MensajeError))
            {
                <div class="alert alert-danger py-2">@Model.MensajeError</div>
            }

            <form asp-controller="RegresionLineal" asp-action="RegresionLineal" method="post" id="formRegresion">
                
                <label class="form-label text-muted small mb-1">Ingresar Punto:</label>
                <div class="d-flex gap-2 mb-3">
                    <input type="number" step="any" id="inputX" class="form-control" placeholder="X" onkeypress="verificarEnter(event)" />
                    <input type="number" step="any" id="inputY" class="form-control" placeholder="Y" onkeypress="verificarEnter(event)" />
                    <button type="button" class="btn btn-success" onclick="agregarPunto()">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </div>

                <label class="form-label text-muted small mb-1">Puntos Ingresados:</label>
                @{
                    string textoPuntos = "";
                    if (Model?.Puntos != null && Model.Puntos.Count > 0)
                    {
                        textoPuntos = string.Join("\n", Model.Puntos.Select(p => $"{p[0]}, {p[1]}"));
                    }
                }

                <label class="form-label text-muted small mb-1">Puntos Ingresados (X, Y):</label>

                <textarea id="txtPuntos" class="form-control mb-3" rows="6" readonly>@textoPuntos</textarea>

                <input type="hidden" name="PuntosCargadosOcultos" id="puntosOcultos" value="" />

                <div class="d-flex gap-2 mb-4 flex-wrap">
                    <button type="button" class="btn btn-danger btn-sm" onclick="borrarUltimo()">Borrar Último</button>
                    <button type="button" class="btn btn-warning btn-sm text-dark" onclick="borrarTodos()">Borrar Todos</button>
                    <button type="button" id="btnEditar" class="btn btn-dark btn-sm text-white" onclick="toggleEdicion()">Editar</button>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg" onclick="prepararEnvio()">Calcular Regresión</button>
                </div>
            </form>
        </div>

        <div class="card p-4 shadow-sm border-0">
            <h4 class="text-secondary mb-4">Datos de Salida</h4>

            @if (Model?.Resultado != null)
            {
                <div class="mb-4">
                    <p class="mb-1"><strong>Función Obtenida:</strong> @Model.Resultado.FuncionObtenida</p>
                    <p class="mb-1"><strong>Correlación (r):</strong> @Model.Resultado.Correlacion</p>
                    <p class="mb-1"><strong>Efectividad del Ajuste:</strong> @Model.Resultado.EfectividadAjuste</p>
                </div>
            }
            else
            {
                <div class="alert alert-light border text-muted mb-4">
                    Ingresá los puntos y presioná calcular para ver los resultados.
                </div>
            }

            <div class="geogebra-container">
                <div id="ggb-element"></div>
            </div>

        </div>
    </div>
</div>
<script src="https://cdn.geogebra.org/apps/deployggb.js"></script>
<script>
    function verificarEnter(event) {
        // Verifica si la tecla presionada es el "Enter"
        if (event.key === "Enter") {
            // Frena el comportamiento por defecto (que enviaría el formulario entero a C# por accidente)
            event.preventDefault();

            // Llama a tu función de agregar punto
            agregarPunto();
        }
    }
    function agregarPunto() {
        const x = document.getElementById('inputX').value;
        const y = document.getElementById('inputY').value;
        const txtArea = document.getElementById('txtPuntos');

        if (x !== "" && y !== "") {
            // Si el cuadro no está vacío, agregamos un salto de línea antes del nuevo punto
            const prefijo = txtArea.value.trim() === "" ? "" : "\n";
            txtArea.value += `${prefijo}${x}, ${y}`;

            // Limpiar inputs
            document.getElementById('inputX').value = '';
            document.getElementById('inputY').value = '';
            document.getElementById('inputX').focus();
        } else {
            alert("Por favor ingrese valores para X e Y.");
        }
    }

    function borrarUltimo() {
        const txtArea = document.getElementById('txtPuntos');
        // Separamos el texto por saltos de línea
        let lineas = txtArea.value.split('\n');

        if (lineas.length > 0 && lineas[0] !== "") {
            lineas.pop(); // Sacamos la última línea
            txtArea.value = lineas.join('\n'); // Volvemos a unir el texto
        }
    }

    function borrarTodos() {
        if(confirm("¿Estás seguro de borrar todos los puntos?")) {
            document.getElementById('txtPuntos').value = '';
        }
    }

    function toggleEdicion() {
        const txtArea = document.getElementById('txtPuntos');
        const btnEditar = document.getElementById('btnEditar');

        // Comprobamos si tiene el atributo 'readonly'
        if (txtArea.hasAttribute('readonly')) {
            // ENTRAR A MODO EDICIÓN
            txtArea.removeAttribute('readonly');
            txtArea.focus(); // Ponemos el cursor adentro

            // Cambiamos el botón para que diga Guardar
                btnEditar.classList.replace('btn-dark', 'btn-success');
                btnEditar.innerHTML = 'Guardar Edición';
                txtArea.style.borderColor = '#0d6efd';
            } else {
                // SALIR DE MODO EDICIÓN
                txtArea.setAttribute('readonly', 'readonly');

                // Restauramos de Verde (success) a Negro (dark)
                btnEditar.classList.replace('btn-success', 'btn-dark');
                btnEditar.innerHTML = 'Editar';
                txtArea.style.borderColor = '#dee2e6';
            }
    }

    function prepararEnvio() {
        const txtArea = document.getElementById('txtPuntos');

        // Reemplazamos los saltos de línea (\n) por punto y coma (;)
        // para que viaje un solo texto limpio hacia el controlador de C#
        let textoLimpio = txtArea.value.trim().replace(/\n/g, ';');

        document.getElementById('puntosOcultos').value = textoLimpio;
    }
    let funcionParaGraficar = "";
    let puntosParaGraficar = [];

    @if (Model?.Resultado != null)
    {
            <text>
                funcionParaGraficar = '@Model.Resultado.FuncionObtenida'.replace(/,/g, '.');
            </text>
    }

    @if (Model?.Puntos != null && Model.Puntos.Count > 0)
    {
            foreach (var p in Model.Puntos)
            {
                    <text>
                        puntosParaGraficar.push({
                            x: @p[0].ToString(System.Globalization.CultureInfo.InvariantCulture),
                            y: @p[1].ToString(System.Globalization.CultureInfo.InvariantCulture)
                        });
                    </text>
            }
    }

    var parameters = {
        "id": "ggbApplet",
        "width": 800,
        "height": 500,
        "showToolBar": false,
        "showMenuBar": false,
        "useBrowserForJS": true,
        "appName": "graphing",   
        "appletOnLoad": function() {

            puntosParaGraficar.forEach((p, index) => {
            let nombrePunto = `Punto${index}`;
            ggbApplet.evalCommand(`${nombrePunto} = (${p.x}, ${p.y})`);
            });

            if (funcionParaGraficar !== "") {
            ggbApplet.evalCommand(funcionParaGraficar);
            }

            if (puntosParaGraficar.length > 0) {
            let minX = Math.min(...puntosParaGraficar.map(p => p.x));
            let maxX = Math.max(...puntosParaGraficar.map(p => p.x));
            let minY = Math.min(...puntosParaGraficar.map(p => p.y));
            let maxY = Math.max(...puntosParaGraficar.map(p => p.y));

            ggbApplet.setCoordSystem(minX - 3, maxX + 3, minY - 3, maxY + 3);
            }
        }
    };

    window.onload = function() {
        if (funcionParaGraficar !== "" || puntosParaGraficar.length > 0) {
            var applet = new GGBApplet(parameters, '5.0');
            applet.inject('ggb-element');
        }
    };
</script>

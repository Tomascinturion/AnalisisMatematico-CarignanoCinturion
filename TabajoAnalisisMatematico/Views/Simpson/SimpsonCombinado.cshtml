@model IntegracionMultiple
@{
    Layout = null;
    ViewData["Title"] = "Simpson Combinado";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    #layoutPrincipal {
        display: grid !important;
        grid-template-columns: 280px 1fr;
        gap: 20px;
        transition: grid-template-columns 0.3s ease;
        align-items: start;
        min-height: 100vh;
        background-color: #f8f9fa;
        padding: 20px;
    }

        #layoutPrincipal.menu-cerrado {
            grid-template-columns: 70px 1fr !important;
        }

    .menu-lateral {
        overflow: hidden;
        white-space: nowrap;
        transition: padding 0.3s ease;
    }

    .menu-content {
        transition: opacity 0.2s ease;
        opacity: 1;
    }

    #layoutPrincipal.menu-cerrado .menu-content {
        opacity: 0;
        pointer-events: none;
    }

    #layoutPrincipal.menu-cerrado .menu-lateral {
        padding: 15px 14px !important;
    }

    .content-area {
        display: grid;
        grid-template-columns: 350px 1fr;
        gap: 20px;
    }

    .graph-container {
        min-height: 500px;
        width: 100%;
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        background-color: #ffffff;
    }

    #ggb-element {
        width: 100%;
        height: 100%;
    }
</style>

<div class="app-container" id="layoutPrincipal">

    <div class="card p-3 shadow-sm border-0 menu-lateral" style="height: fit-content;">
        <div class="d-flex justify-content-end mb-3">
            <button type="button" class="btn btn-dark btn-sm" onclick="toggleMenu()" title="Ocultar Menú">
                <i class="bi bi-list fs-5"></i>
            </button>
        </div>

        <div class="menu-content">
            <div class="mb-3 d-flex gap-2 flex-wrap">
                <a class="btn btn-dark btn-sm" href="/Home/Index">Unidad 1</a>
                <a class="btn btn-dark btn-sm" href="/GaussJordan/GJ">Unidad 2</a>
                <a class="btn btn-dark btn-sm" href="/RegresionLineal/RegresionLineal">Unidad 3</a>
                <a class="btn btn-dark btn-sm" href="#">Unidad 4</a>
            </div>
            <ul class="nav nav-tabs mb-3 flex-column border-0">
                <li class="nav-item">
                    <a class="nav-link text-muted" href="/Trapecios/TrapecioSimple">Trapecio Simple</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-muted" href="/Trapecios/TrapecioMultiple">Trapecio Multiple</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-muted" href="/Simpson/Simpson13Simple">Simpson 1/3 Simple</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-muted" href="/Simpson/Simpson13Multiple">Simpson 1/3 Multiple</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-muted" href="/Simpson/Simpson38">Simpson 3/8</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active text-dark fw-bold border-bottom" href="#">1/3 Multiple y 3/8 Combinados</a>
                </li>
            </ul>
        </div>
    </div>

    <div class="content-area">

        <div class="card p-4 shadow-sm border-0" style="height: fit-content;">
            <h4 class="text-secondary mb-4">Datos de Entrada</h4>

            @if (!string.IsNullOrEmpty(Model?.MensajeError))
            {
                <div class="alert alert-danger py-2 shadow-sm border-0">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.MensajeError
                </div>
            }

            <form asp-controller="Simpson" asp-action="SimpsonCombinado" method="post">

                <div class="mb-3">
                    <label class="form-label fw-bold mb-0">Función</label>
                    <input type="text" class="form-control bg-light" name="Funcion" value="@Model?.Funcion" placeholder="Ej: x^2 + 2" required>
                    <small class="text-muted">Función a integrar f(x)</small>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold mb-0">Extremo Izquierdo (Xi)</label>
                    <input type="text" step="any" class="form-control bg-light" name="Xi" value="@Model?.Xi" required>
                    <small class="text-muted">Límite inferior de integración</small>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold mb-0">Extremo Derecho (Xd)</label>
                    <input type="text" step="any" class="form-control bg-light" name="Xd" value="@Model?.Xd" required>
                    <small class="text-muted">Límite superior de integración</small>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold mb-0">Intervalos (N)</label>
                    <input type="number" class="form-control bg-light" name="N" value="@(Model?.N > 0 ? Model.N : 3)" min="2" required>
                    <small class="text-muted">Cantidad de subintervalos (Par o Impar)</small>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold" style="background-color: #5c7cfa; border: none;">CALCULAR ÁREA</button>
            </form>
        </div>

        <div class="d-flex flex-column gap-3">

            @if (Model?.Resultado != null)
            {
                <div class="card shadow-sm border-0">
                    <div class="card-header text-white text-center py-3" style="background-color: #343a40;">
                        <h5 class="mb-0">Resultado de la Integración</h5>
                    </div>
                    <div class="card-body px-4 py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-muted fs-5">Área Aproximada:</span>
                            <span class="fs-3 fw-bold text-primary">@Model.Resultado.Value.ToString("F6")</span>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-light border text-muted shadow-sm text-center">
                    <i class="bi bi-graph-up me-2"></i> Ingrese la función y los límites para calcular el área.
                </div>
            }

            <div class="graph-container shadow-sm p-2">
                <div id="ggb-element"></div>
            </div>

        </div>
    </div>
</div>

<script src="https://cdn.geogebra.org/apps/deployggb.js"></script>
<script>
    function toggleMenu() {
    const layout = document.getElementById('layoutPrincipal');
    layout.classList.toggle('menu-cerrado');
    setTimeout(() => { window.dispatchEvent(new Event('resize')); }, 300);
    }

    function adaptarFuncionParaGeoGebra(funcion) {
    if (!funcion) return funcion;

    return funcion
    // Calculus interpreta log(x) como ln(x).
    // GeoGebra interpreta log(x) como logaritmo base 10.
    .replace(/\blog\s*\(/gi, 'ln(');
    }

    function numeroGeoGebra(valor) {
    return Number(valor).toFixed(12).replace(/\.?0+$/, '');
    }

    function ocultarEnVista(ggbApi, nombreObjeto) {
    try {
    ggbApi.evalCommand(`SetVisibleInView(${nombreObjeto}, 1, false)`);
    ggbApi.showLabel(nombreObjeto, false);
    } catch (error) {
    console.warn(`No se pudo ocultar ${nombreObjeto}:`, error);
    }
    }

    function dibujarBloquesSimpson13(ggbApi, a, h, limite13) {
    // Simpson 1/3 usa bloques de 2 subintervalos.
    // Si limite13 = 6, genera bloques i = 0, 2, 4.
    for (let i = 0; limite13 - 2 >= i; i += 2) {
    const x0 = a + i * h;
    const x1 = a + (i + 1) * h;
    const x2 = a + (i + 2) * h;

    const x0g = numeroGeoGebra(x0);
    const x1g = numeroGeoGebra(x1);
    const x2g = numeroGeoGebra(x2);

    try {
    ggbApi.evalCommand(`P13_${i} = (${x0g}, f(${x0g}))`);
    ggbApi.evalCommand(`Q13_${i} = (${x1g}, f(${x1g}))`);
    ggbApi.evalCommand(`R13_${i} = (${x2g}, f(${x2g}))`);

    ggbApi.evalCommand(`Poly13_${i}(x) = Polynomial({P13_${i}, Q13_${i}, R13_${i}})`);

    ggbApi.evalCommand(`Area13_${i} = Integral(Poly13_${i}, ${x0g}, ${x2g})`);

    ggbApi.setColor(`Area13_${i}`, 92, 124, 250);
    ggbApi.setFilling(`Area13_${i}`, 0.4);

    ggbApi.setColor(`Poly13_${i}`, 220, 53, 69);
    ggbApi.setLineThickness(`Poly13_${i}`, 2);

    // Ocultar la parábola auxiliar y los puntos.
    // Queda visible solamente el área.
    ocultarEnVista(ggbApi, `Poly13_${i}`);
    ocultarEnVista(ggbApi, `P13_${i}`);
    ocultarEnVista(ggbApi, `Q13_${i}`);
    ocultarEnVista(ggbApi, `R13_${i}`);

    ggbApi.showLabel(`Area13_${i}`, false);

    console.log(`Bloque Simpson 1/3 dibujado: Area13_${i}, desde ${x0g} hasta ${x2g}`);
    }
    catch (errorBloque13) {
    console.error(`Error dibujando bloque Simpson 1/3 i=${i}:`, errorBloque13);
    }
    }
    }

    function dibujarBloqueSimpson38(ggbApi, a, b, h, limite13) {
    const start38 = a + limite13 * h;
    const x1 = start38 + h;
    const x2 = start38 + 2 * h;
    const x3 = b;

    const x0g = numeroGeoGebra(start38);
    const x1g = numeroGeoGebra(x1);
    const x2g = numeroGeoGebra(x2);
    const x3g = numeroGeoGebra(x3);

    try {
    ggbApi.evalCommand(`P38 = (${x0g}, f(${x0g}))`);
    ggbApi.evalCommand(`Q38 = (${x1g}, f(${x1g}))`);
    ggbApi.evalCommand(`R38 = (${x2g}, f(${x2g}))`);
    ggbApi.evalCommand(`S38 = (${x3g}, f(${x3g}))`);

    ggbApi.evalCommand(`Poly38(x) = Polynomial({P38, Q38, R38, S38})`);

    ggbApi.evalCommand(`Area38 = Integral(Poly38, ${x0g}, ${x3g})`);

    ggbApi.setColor(`Area38`, 32, 201, 151);
    ggbApi.setFilling(`Area38`, 0.5);

    ggbApi.setColor(`Poly38`, 220, 53, 69);
    ggbApi.setLineThickness(`Poly38`, 2);

    // Ocultar la cúbica auxiliar y los puntos.
    // Queda visible solamente el área.
    ocultarEnVista(ggbApi, `Poly38`);
    ocultarEnVista(ggbApi, `P38`);
    ocultarEnVista(ggbApi, `Q38`);
    ocultarEnVista(ggbApi, `R38`);
    ocultarEnVista(ggbApi, `S38`);

    ggbApi.showLabel(`Area38`, false);

    console.log(`Bloque Simpson 3/8 dibujado: Area38, desde ${x0g} hasta ${x3g}`);
    }
    catch (errorBloque38) {
    console.error("Error dibujando bloque Simpson 3/8:", errorBloque38);
    }
    }

    function aplicarZoomAutomatico(ggbApi, a, b, n) {
    const h = (b - a) / n;

    let minY = 0;
    let maxY = 0;

    for (let i = 0; n >= i; i++) {
    const x = a + i * h;
    const xg = numeroGeoGebra(x);
    const y = ggbApi.getValue(`f(${xg})`);

    if (!isNaN(y) && isFinite(y)) {
    minY = Math.min(minY, y);
    maxY = Math.max(maxY, y);
    }
    }

    const margenX = Math.abs(b - a) * 0.15 || 1;

    let margenY = Math.abs(maxY - minY) * 0.25;
    if (margenY === 0) {
    margenY = 1;
    }

    ggbApi.setCoordSystem(
    a - margenX,
    b + margenX,
    minY - margenY,
    maxY + margenY
    );
    }

    // --- LÓGICA DE GEOGEBRA: SIMPSON COMBINADO ---
    @if (Model?.Resultado != null)
    {
        <text>
            document.addEventListener("DOMContentLoaded", function () {
            const ggbContainer = document.getElementById('ggb-element');

            if (ggbContainer) {

            const funcionOriginal = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Funcion ?? ""));
            const funcionStr = adaptarFuncionParaGeoGebra(funcionOriginal.replace(/,/g, '.'));

            const a = @Model.Xi.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const b = @Model.Xd.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const n = parseInt('@Model.N');

            const params = {
            "appName": "classic",
            "width": ggbContainer.parentElement.clientWidth,
            "height": 500,
            "showToolBar": false,
            "showAlgebraInput": false,
            "showMenuBar": false,
            "useBrowserForJS": true,
            "language": "en",

            "appletOnLoad": function (ggbApi) {
            try {
            // 1. Dibujar la función original
            ggbApi.evalCommand('f(x) = ' + funcionStr);
            ggbApi.setColor('f', 33, 37, 41);
            ggbApi.setLineThickness('f', 3);

            // 2. Validar N
            if (isNaN(n) || !(n >= 2)) {
            console.error("Simpson combinado requiere N mayor o igual a 2.");
            return;
            }

            const h = (b - a) / n;

            // 3. Determinar hasta dónde va Simpson 1/3
            let limite13 = n;

            // Si N es impar, los últimos 3 subintervalos se resuelven con Simpson 3/8.
            if (n % 2 !== 0) {
            limite13 = n - 3;

            // Si N = 3, limite13 queda en 0.
            // En ese caso se dibuja solo Simpson 3/8.
            dibujarBloqueSimpson38(ggbApi, a, b, h, limite13);
            }

            // 4. Dibujar Simpson 1/3 en el resto de los intervalos
            if (limite13 >= 2) {
            dibujarBloquesSimpson13(ggbApi, a, h, limite13);
            }

            // 5. Auto-Zoom
            aplicarZoomAutomatico(ggbApi, a, b, n);

            } catch (error) {
            console.error("Error graficando en GeoGebra: ", error);
            alert("Error graficando en GeoGebra: " + error.message);
            }
            }
            };

            const applet = new GGBApplet(params, true);
            applet.inject('ggb-element');
            }
            });
        </text>
    }
</script>